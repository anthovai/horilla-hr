# Backup settings -- copy to deploy/saas/backup.env (git-ignored):
#   cp deploy/saas/backup.env.example deploy/saas/backup.env && chmod 600 deploy/saas/backup.env
# Only the `backup` container reads this file.

# ---- Schedule (crond inside the container, TZ=Asia/Bangkok) ---------------
BACKUP_SCHEDULE=30 2 * * *

# ---- Encryption (age, https://age-encryption.org) -------------------------
# PUBLIC key(s) only, space separated. Generate the pair OFF this server:
#   age-keygen -o orvahr-backup-key.txt     # prints "Public key: age1..."
# Keep orvahr-backup-key.txt in a password manager + a printed copy in a safe.
# The server can encrypt but never decrypt, so a stolen Mac or a leaked bucket
# does not expose old backups. Add a second recipient (a colleague's key) so
# one lost key is not the end of every backup.
AGE_RECIPIENTS=age1replace-with-your-public-key

# ---- Retention (number of backup sets kept per tier, local and offsite) ---
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
# Weekly set taken on this weekday (1=Mon ... 7=Sun); monthly on the 1st.
WEEKLY_DAY=7

# ---- Per-tenant dumps -----------------------------------------------------
# all  = also write one pg_dump per tenant schema (handy to restore or hand
#        over a single customer); empty = whole-database dump only;
#        or a space separated list of schema names.
TENANT_SCHEMAS=all

# ---- Offsite copy (rclone, configured entirely through env) ---------------
# Leave RCLONE_REMOTE empty to keep backups local only (not recommended).
# Remote name "offsite" below matches the RCLONE_CONFIG_OFFSITE_* block.
RCLONE_REMOTE=offsite:orvahr-backups/macmini
# Delete offsite sets beyond the retention counts. Set 0 when the key is
# write-only / the bucket has Object Lock and a lifecycle rule (preferred:
# a compromised server then cannot erase the offsite history).
RCLONE_PRUNE=1

# Example: any S3-compatible bucket (Cloudflare R2, Backblaze B2, Wasabi,
# AWS S3 ap-southeast-7 Bangkok, NIPA Cloud / other Thai S3 providers ...).
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example-provider.com
RCLONE_CONFIG_OFFSITE_REGION=auto
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=change-me
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=change-me
# Needed by some providers when the key cannot create/check buckets.
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# ---- Monitoring -----------------------------------------------------------
# Optional dead-man's switch (healthchecks.io, Better Stack heartbeat, Uptime
# Kuma push URL ...). Pinged on success, "<url>/fail" on failure.
BACKUP_PING_URL=
