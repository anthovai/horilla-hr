# OrvaHR SaaS -- copy to the repository root as .env and fill in:
#   cp deploy/saas/env.saas.example .env && chmod 600 .env
# .env is git-ignored. Never commit it, never paste it into a ticket or chat.
# Generate secrets with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-50

# Separate project name => separate containers and volumes (orvahr-saas_*)
# from the dev/demo stack ("orvahr") that may also run on this Mac.
COMPOSE_PROJECT_NAME=orvahr-saas

DJANGO_SETTINGS_MODULE=horilla.settings
DEBUG=False
HORILLA_ENV=production
TIME_ZONE=Asia/Bangkok

# ---- Domain ---------------------------------------------------------------
# A domain dedicated to the product (apex = marketing/signup/public schema,
# <tenant>.<domain> = customers). Prefer an apex such as orvahr.example over a
# subdomain like hr.example.com: Cloudflare's free certificate covers only one
# wildcard level.
ORVAHR_BASE_DOMAIN=orvahr.example
# Leading dot = the domain and every subdomain (Django ALLOWED_HOSTS syntax).
ALLOWED_HOSTS=.orvahr.example
# Django 4+ accepts a wildcard subdomain here; the apex needs its own entry.
CSRF_TRUSTED_ORIGINS=https://orvahr.example,https://*.orvahr.example

# ---- TLS / proxy (Cloudflare -> cloudflared -> nginx -> gunicorn) ----------
# nginx always sends X-Forwarded-Proto: https; Django trusts it via
# SECURE_PROXY_SSL_HEADER (horilla/settings/security.py, always on in prod).
SECURE_SSL_REDIRECT=1
# Start low; raise to 31536000 once every subdomain is known to work on HTTPS.
# Django also sends includeSubDomains + preload with this, so it applies to
# EVERY subdomain of ORVAHR_BASE_DOMAIN.
SECURE_HSTS_SECONDS=3600
# Only nginx's X-Forwarded-For is believed (horilla/client_ip.py). nginx sets
# it to the real visitor IP from CF-Connecting-IP. Do not add cloudflared.
HORILLA_TRUSTED_PROXIES=nginx
# Host-only port for the local uptime check (8080 = erp-api, 80/443 = kgf-caddy).
ORVAHR_PROXY_PORT=8480
# Private subnet for the nginx<->cloudflared network. Change only if it
# collides with another Docker network (`docker network inspect`).
ORVAHR_EDGE_SUBNET=172.31.240.0/24

# Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > token
CLOUDFLARE_TUNNEL_TOKEN=paste-the-tunnel-token-here

# ---- Django secrets -------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-value
DB_INIT_PASSWORD=change-me-db-init-password

# ---- Postgres -------------------------------------------------------------
POSTGRES_DB=horilla_db
POSTGRES_USER=horilla_user
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgres://horilla_user:change-me-db-password@db:5432/horilla_db
DB_HOST=db
DB_PORT=5432

# ---- Redis ----------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ---- Gunicorn -------------------------------------------------------------
# 3 workers x 4 threads fits the 2 CPU / 2 GB limit on `web`.
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info

# ---- Payroll engine -------------------------------------------------------
ORVAHR_PAYROLL_ENGINE_MODE=off

# ---- Backups --------------------------------------------------------------
# Host directory (outside the Colima VM) that receives the encrypted backup
# sets. Must be under $HOME (Colima mounts only $HOME by default). Absolute path.
ORVAHR_BACKUP_HOST_DIR=/Users/CHANGE-ME/OrvaHR-backups
# Encryption key, rclone remote and schedule go in deploy/saas/backup.env
# (see deploy/saas/backup.env.example) so the web containers never see them.
